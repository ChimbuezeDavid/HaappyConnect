{
  "expo": {
    "name": "Happy Connect",
    "slug": "HaappyConnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "favicon": "./assets/images/favicon.png",
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "scheme": "haappyconnect",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.anonymous.haappyconnect",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "HaappyConnect needs camera access for live video calls.",
        "NSMicrophoneUsageDescription": "HaappyConnect needs microphone access for live video calls."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#061431",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.HaappyConnect",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },

    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow HaappyConnect to access your camera for video consultations.",
          "microphonePermission": "Allow HaappyConnect to access your microphone for video consultations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
